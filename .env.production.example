# Copy sang .env.production trên VPS rồi điền giá trị thật. KHÔNG commit .env.production.
# docker compose --env-file .env.production up -d --build

# --- Domain (Caddy dùng) ---
DOMAIN=abc.com

# --- Postgres (chỉ dùng trong network docker) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=doi_mat_khau_manh
POSTGRES_DB=ecommerce

# --- App ---
PORT=4000
TZ=Asia/Ho_Chi_Minh
# Dùng cho `src/shared/config.ts`
Admin_email=admin@abc.com
Admin_name=admin
Admin_password=doi_mat_khau_manh
ADMIN_ID=1

# CORS: domain của FE (nhiều domain thì cách nhau dấu phẩy)
FRONTEND_URL=https://app.abc.com
FRONTEND_URL_DEV=http://localhost:3000

# --- JWT ---
ACCESS_TOKEN_SECRET=thay_bang_chuoi_ngau_nhien_32_ky_tu
REFRESH_TOKEN_SECRET=thay_bang_chuoi_ngau_nhien_32_ky_tu
ACCESS_TOKEN_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# --- Dịch vụ ngoài ---
RESEND_API_KEY=re_xxxxxxxxxx
PAYMENT_API_KEY=xxxxxxxxxx
CLOUDINARY_NAME=xxxx
CLOUDINARY_KEY=xxxx
CLOUDINARY_SECRET=xxxx
VNPAY_TMN_CODE=xxxx
VNPAY_SECRET_KEY=xxxx
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=https://api.abc.com/payment/vnpay/return

# --- Thoi han luu nhat ky (AccessLog, LoginAttempt) ---
# Con so do nguoi ky chinh sach chot (docs/pii-retention-policy.md §3) — sua o day, khong sua trong code.
# De trong = KHONG don (job tu bo qua va ghi log ly do). Job chay 03:00 ngay 1 moi thang.
LOG_RETENTION_MONTHS=12
# --- Bat buoc 2FA cho ADMIN/KE_TOAN ---
# on = phien cua tai khoan chua bat 2FA chi goi duoc POST /auth/2fa/setup, /auth/2fa/enable va
# /auth/logout; moi route khac tra 403 Error.TwoFactorEnrolmentRequired.
# De TRONG = khong ai bi chan (mac dinh, co y: bat rao chan la quyet dinh rollout, khong phai he qua
# cua mot lan deploy).
# BAT SAU KHI FE co man hinh enrolment, neu khong la khoa cua moi ADMIN. Quy trinh: docs/deploy.md.
# TWO_FACTOR_ENFORCEMENT=on
