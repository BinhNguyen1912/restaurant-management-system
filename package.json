{
  "name": "ecommerce-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "init-seed-data": "npx ts-node src/scripts/ScriptOfSystem/index.ts",
    "create-permissions": "npx ts-node src/scripts/ScriptOfSystem/create-permissions.ts",
    "unit-seed": "npx ts-node src/scripts/ScriptOfSystem/unit.seed.ts",
    "build": "nest build",
    "email:dev": "email dev",
    "initScript": "npx ts-node --require tsconfig-paths/register initialScript/index.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev": "nest start --watch -r tsconfig-paths/register",
    "start:debug": "nest start --debug --watch -r tsconfig-paths/register",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed:ledger-accounts": "npx ts-node -r tsconfig-paths/register src/scripts/ScriptOfSystem/ledger-accounts.seed.ts",
    "seed:catalog": "npx ts-node -r tsconfig-paths/register src/scripts/ScriptOfSystem/catalog.seed.ts",
    "seed:landing-products": "ts-node -r tsconfig-paths/register src/scripts/ScriptOfSystem/seed-landing-products.ts",
    "tables:close-stale": "ts-node -r tsconfig-paths/register src/scripts/ScriptOfSystem/close-stale-tables.ts",
    "seed:demo:clear": "ts-node -r tsconfig-paths/register src/scripts/ScriptOfSystem/clear-demo-seed.ts",
    "seed:demo": "npx ts-node -r tsconfig-paths/register src/scripts/ScriptOfSystem/demo-data.seed.ts",
    "db:dump": "npx ts-node -r tsconfig-paths/register src/scripts/ScriptOfSystem/dump-data.ts"
  },
  "dependencies": {
    "@keyv/redis": "^2.8.5",
    "@nestjs/bull": "^11.0.3",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "10.4.17",
    "@nestjs/core": "10.4.17",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "10.4.17",
    "@nestjs/platform-socket.io": "10.4.17",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "10.4.17",
    "@prisma/client": "^6.14.0",
    "@react-email/components": "0.0.41",
    "@types/bcrypt": "^5.0.2",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "buffer-to-stream": "^1.0.0",
    "bullmq": "^5.61.0",
    "cache-manager": "^6.4.3",
    "cache-manager-redis-store": "^3.0.1",
    "class-validator": "^0.14.2",
    "cloudinary": "^2.7.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.6.1",
    "fs": "^0.0.1-security",
    "googleapis": "^150.0.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "ms": "^2.1.3",
    "nestjs-zod": "^5.0.1",
    "otpauth": "^9.4.0",
    "prisma": "^6.14.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "reflect-metadata": "0.2.2",
    "request-ip": "^3.3.0",
    "resend": "^4.5.1",
    "rxjs": "^7.8.1",
    "uuid": "^11.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/cron": "^2.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "prisma-json-types-generator": "^3.5.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}
