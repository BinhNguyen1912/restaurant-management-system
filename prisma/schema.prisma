/// Đối soát theo kỳ (ticket #13): mỗi lần chạy là 1 "run" giữ lại làm bằng chứng,
/// không tính live rồi quên. Sai lệch được ghi thành từng item để người ta xử lý tiếp.
enum ReconciliationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum ReconciliationKind {
  /// khớp: Payment SUCCESS có đúng 1 bút toán, số tiền trùng
  MATCHED
  /// có Payment SUCCESS nhưng KHÔNG có bút toán (tiền đã thu, sổ không biết)
  MISSING_IN_LEDGER
  /// có bút toán nhưng số tiền khác Payment
  AMOUNT_MISMATCH
  /// 1 Payment có nhiều hơn 1 bút toán
  DUPLICATE
  /// VNPay báo trạng thái khác Payment nội bộ (querydr)
  STATUS_MISMATCH
}

enum ReconciliationItemStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum ReconciliationRefType {
  PAYMENT
  VNPAY
}

model ReconciliationRun {
  id         Int                     @id @default(autoincrement())
  /// kỳ theo ngày nghiệp vụ (giờ VN), lưu dạng DATE
  periodFrom DateTime                @db.Date
  periodTo   DateTime                @db.Date
  branchId   Int?
  branch     Branch?                 @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status     ReconciliationRunStatus @default(RUNNING)
  /// đếm theo kind + tổng tiền (Json để thêm loại kiểm mới không phải migrate)
  summary    Json?
  /// lý do run FAILED (không im lặng)
  error      String?                 @db.VarChar(1000)
  startedAt  DateTime                @default(now())
  finishedAt DateTime?

  items ReconciliationItem[]

  @@index([branchId, periodFrom])
  @@index([status, startedAt])
}

model ReconciliationItem {
  id             Int                      @id @default(autoincrement())
  runId          Int
  run            ReconciliationRun        @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  kind           ReconciliationKind
  refType        ReconciliationRefType
  /// Payment.id (hoặc mã giao dịch VNPay) — khoá để tra ngược
  refId          Int
  paymentId      Int?
  ledgerEntryId  Int?
  transactionId  String?                  @db.VarChar(128)
  amountExpected Decimal                  @db.Decimal(14, 2)
  amountActual   Decimal                  @db.Decimal(14, 2)
  amountDelta    Decimal                  @default(0) @db.Decimal(14, 2)
  status         ReconciliationItemStatus @default(OPEN)
  detail         Json?
  createdAt      DateTime                 @default(now())

  @@index([runId, kind])
  @@index([paymentId])
}

/// Nhật ký thao tác nhạy cảm (ticket #10 / ADR 0001 D9): huỷ đơn, giảm giá, hoàn tiền, sửa giá.
/// CHỈ GHI qua AuditLogService, CHỈ ĐỌC qua API — không có endpoint sửa/xoá.
enum AuditAction {
  ORDER_CANCELLED
  ORDER_DISCOUNT_CHANGED
  ORDER_PRICE_CHANGED
  PRODUCT_PRICE_CHANGED
  PAYMENT_REFUNDED
  /// cấp/thu hồi quyền của 1 vai trò
  ROLE_PERMISSIONS_CHANGED
  ROLE_CREATED
  ROLE_DELETED
  /// đổi vai trò hoặc chi nhánh của một tài khoản
  USER_ACCESS_CHANGED
  /// nhập hàng: tồn kho tăng, có ảnh bằng chứng
  STOCK_RECEIVED
  /// đăng nhập sai quá ngưỡng => tài khoản bị khoá tạm (prod-readiness §0.2 #3)
  LOGIN_LOCKED
  /// trừ điểm khách để giảm giá một hoá đơn (kèm số điểm và số tiền đã giảm)
  POINTS_REDEEMED
  /// ghi nhận/rút đồng ý xử lý dữ liệu cá nhân của khách (NĐ 13/2023)
  CONSENT_RECORDED
  /// ẩn danh hoá hồ sơ khách đã hết thời hạn lưu (NĐ 13/2023) — before/after KHÔNG chứa PII
  CUSTOMER_ANONYMIZED
  /// sửa ghi chú chăm sóc của hồ sơ khách — before/after chỉ ghi ĐỘ DÀI, không ghi nội dung
  CUSTOMER_NOTE_UPDATED
  /// bật 2FA bằng ứng dụng xác thực (NĐ 13/2023 Điều 26 — bảo vệ tài khoản quản trị)
  TWO_FACTOR_ENABLED
  /// tắt 2FA (phải nhập lại mật khẩu + một mã thứ hai) — tắt được 2FA là tắt luôn rào chắn
  TWO_FACTOR_DISABLED
}

enum AuditEntityType {
  ORDER
  PRODUCT
  SKU
  PAYMENT
  ROLE
  USER
  INGREDIENT
  CUSTOMER
}

model AuditLog {
  id         Int             @id @default(autoincrement())
  /// User.id người thao tác (null = hệ thống/cron)
  actorId    Int?
  /// tên role tại thời điểm thao tác (ADMIN/STAFF/...) — giữ chuỗi, không FK: role đổi tên vẫn đọc được
  actorRole  String?         @db.VarChar(50)
  action     AuditAction
  entityType AuditEntityType
  entityId   Int
  /// trạng thái trước/sau để giải trình (Json: chỉ trường thay đổi)
  before     Json?
  after      Json?
  /// lý do — BẮT BUỘC với huỷ đơn / hoàn tiền
  reason     String?         @db.VarChar(500)
  branchId   Int?
  branch     Branch?         @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt  DateTime        @default(now())

  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@index([branchId, createdAt])
}

/// Kết quả một lần thử đăng nhập bằng mật khẩu.
enum LoginOutcome {
  SUCCESS
  FAILED
}

/// Nhật ký THỬ ĐĂNG NHẬP (NĐ 13/2023/NĐ-CP Điều 26 + kiểm soát nội bộ).
///
/// Hai câu hỏi mà `AuditLog` không trả lời được: tài khoản này có đang bị dò không (kể cả khi chưa
/// tới ngưỡng khoá, và cả khi tài khoản KHÔNG TỒN TẠI), và một IP đang thử bao nhiêu tài khoản khác
/// nhau. `LOGIN_LOCKED` chỉ có một dòng khi đã khoá — tức là sau khi đã trả giá 5 lượt.
///
/// Tách khỏi `AccessLog`: đó là nhật ký ĐỌC dữ liệu cá nhân, đăng nhập không đọc hồ sơ nào. Gộp vào
/// thì `route` của `AccessLog` phải giả vờ có một route đọc, và câu "ai đã đọc dữ liệu của tôi" bị
/// pha loãng bởi hàng nghìn dòng đăng nhập.
///
/// APPEND-ONLY (trigger DB chặn UPDATE), DELETE vẫn cho phép để dọn theo thời hạn lưu.
model LoginAttempt {
  id        Int          @id @default(autoincrement())
  /// sha256(email đã chuẩn hoá) — 64 ký tự hex. Xem `emailFingerprint`.
  ///
  /// Không lưu email thô: bảng này append-only, chép email vào đây là nhân bản dữ liệu cá nhân sang
  /// một nơi không xoá được, và biến bảng nhật ký bảo mật thành một danh sách email để rò rỉ.
  /// Hash ĐỦ để tương quan các lần thử cùng một định danh. Hash KHÔNG phải ẩn danh: với email đã
  /// biết thì tra từ điển là ra — đừng dùng cột này như dữ liệu đã khử định danh.
  emailHash String       @db.Char(64)
  /// User.id của tài khoản bị thử, null khi email không tồn tại.
  ///
  /// Cố ý KHÔNG có khoá ngoại: xoá tài khoản không được làm biến mất bằng chứng "đã có người thử dò
  /// tài khoản này". `actorId` còn lại chỉ là một con số, không phải PII.
  actorId   Int?
  outcome   LoginOutcome
  /// IP nơi thử đăng nhập (null khi không đọc được) — cũng là dữ liệu cá nhân, xem thời hạn lưu
  ip        String?      @db.VarChar(45)
  createdAt DateTime     @default(now())

  /// "tài khoản này bị thử bao nhiêu lần" — tra theo hash
  @@index([emailHash, createdAt])
  /// "IP này đang thử những tài khoản nào" — dấu hiệu dò ngược
  @@index([ip, createdAt])
  /// dọn theo thời hạn lưu
  @@index([createdAt])
}
