/// Ca làm việc + két tiền mặt (ADR 0001 D7).
/// Đối soát cuối ca là nguồn thứ hai để đối chiếu với sổ cái (CASH).
enum CashShiftStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  /// Thu tiền vào két (không phải doanh thu: đổi tiền lẻ, nộp thêm quỹ...)
  IN
  /// Chi tiền ra khỏi két (mua vặt, trả nhà cung cấp, nộp quỹ...)
  OUT
}

model CashShift {
  id            Int             @id @default(autoincrement())
  branchId      Int
  /// Người mở ca
  staffId       Int
  status        CashShiftStatus @default(OPEN)
  openedAt      DateTime        @default(now())
  closedAt      DateTime?
  /// Tiền lẻ/tiền mặt có sẵn trong két khi mở ca
  openingFloat  Decimal         @db.Decimal(14, 2)
  /// Số tiền mặt thực đếm khi đóng ca
  countedCash   Decimal?        @db.Decimal(14, 2)
  /// openingFloat + Σ thu tiền mặt + Σ IN - Σ OUT (chốt tại thời điểm đóng)
  expectedCash  Decimal?        @db.Decimal(14, 2)
  /// countedCash - expectedCash (>0 thừa, <0 thiếu)
  variance      Decimal?        @db.Decimal(14, 2)
  /// Σ Payment CASH đã PAID trong ca (chốt tại thời điểm đóng)
  cashIn        Decimal         @default(0) @db.Decimal(14, 2)
  /// Σ CashMovement OUT trong ca
  cashOut       Decimal         @default(0) @db.Decimal(14, 2)
  note          String?         @db.VarChar(500)
  closedById    Int?
  /// Bút toán ghi lệch két (thiếu/thừa), null nếu khớp
  ledgerEntryId Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff     User           @relation("CashShiftStaff", fields: [staffId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  closedBy  User?          @relation("CashShiftClosedBy", fields: [closedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  movements CashMovement[]

  @@index([branchId, status])
  @@index([branchId, openedAt])
  @@index([staffId])
}

model CashMovement {
  id           Int              @id @default(autoincrement())
  shiftId      Int
  type         CashMovementType
  reason       String           @db.VarChar(255)
  amount       Decimal          @db.Decimal(14, 2)
  /// Ảnh/video chứng từ (hoá đơn, biên nhận) — Cloudinary URL
  evidenceUrls String[]         @default([])
  branchId     Int
  createdById  Int?
  createdAt    DateTime         @default(now())

  shift     CashShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy User?     @relation("CashMovementCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([shiftId])
}

model Reminders {
