  name                  String
  refreshToken          String?
  refreshTokenExpiresAt DateTime?
  createdById           Int?
  updatedById           Int?
  deletedById           Int?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  tableNodeId           Int
  createdBy             User?     @relation("GuestCreateBy", fields: [createdById], references: [id], onDelete: NoAction)
  deletedBy             User?     @relation("GuestDeleteBy", fields: [deletedById], references: [id], onDelete: NoAction)
  tableNode             TableNode @relation(fields: [tableNodeId], references: [id], onUpdate: NoAction)
  updatedBy             User?     @relation("GuestUpdateBy", fields: [updatedById], references: [id], onDelete: NoAction)
  messages              Message[] @relation("FromGuest")
  receivedMessages      Message[] @relation("ToGuest")
  orders                Order[]
  sockets               Socket[]

  @@index([tableNodeId])
}

model Table {
  number      Int         @id
  capacity    Int
  status      TableStatus @default(AVAILABLE)
  token       String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdById Int?
  deletedAt   DateTime?
  deletedById Int?
  updatedById Int?
  createdBy   User?       @relation("TableCreateBy", fields: [createdById], references: [id], onDelete: NoAction)
  deletedBy   User?       @relation("TableDeleteBy", fields: [deletedById], references: [id], onDelete: NoAction)
  updatedBy   User?       @relation("TableUpdateBy", fields: [updatedById], references: [id], onDelete: NoAction)
  branchId    Int
  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Reservation {
  id              Int               @id @default(autoincrement())
  userId          Int
  customerName    String
  customerPhone   String
  guestCount      Int
  reservationTime DateTime
  hasPreOrder     Boolean
  status          ReservationStatus @default(PENDING)
  depositAmount   Int?
  depositPercent  Int?
  createdById     Int?
  updatedById     Int?
  check_in_time   DateTime?
  deletedAt       DateTime?
  note            String?
  deletedById     Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  tableNodeId     Int
  /// Hồ sơ khách của lượt đặt bàn (null = SĐT không chuẩn hoá được, xem customer.identity.ts)
  customerId      Int?
  orders          Order[]
  createdBy       User?             @relation("ReservationCreateBy", fields: [createdById], references: [id])
  deletedBy       User?             @relation("ReservationDeleteBy", fields: [deletedById], references: [id])
  tableNode       TableNode?        @relation(fields: [tableNodeId], references: [id])
  updatedBy       User?             @relation("ReservationUpdateBy", fields: [updatedById], references: [id])
  user            User              @relation("ReservationUser", fields: [userId], references: [id])
  customer        Customer?         @relation(fields: [customerId], references: [id])
  branchId        Int
  branch          Branch            @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  /// danh sách đặt bàn theo thời gian (lọc deletedAt + sắp theo reservationTime)
  @@index([deletedAt, reservationTime])
  /// hồ sơ khách: lịch sử đặt bàn của một người
  @@index([customerId, reservationTime])
}

/// Hồ sơ khách hàng (tầng CRM). Trước đây "khách" chỉ là chuỗi `customerName`/`customerPhone`
/// tự do trên từng lượt đặt bàn: gõ ba lần là ba khách khác nhau, không ai biết khách nào quay
/// lại hay chi bao nhiêu. Một dòng = một người, nhận diện bằng SĐT đã chuẩn hoá
/// (`src/routes/customer/customer.identity.ts`), nên mọi thứ đọc từ đơn/đặt bàn đều quy về đây.
model Customer {
  id           Int       @id @default(autoincrement())
  /// SĐT chuẩn hoá dạng 0xxxxxxxxx (chỉ chữ số) — khoá nhận diện duy nhất của khách
  phone        String    @unique @db.VarChar(20)
  name         String    @db.VarChar(255)
  email        String?   @db.VarChar(255)
  /// Tài khoản khách đã đăng ký (nếu có) — hồ sơ này là cùng một người với tài khoản đó
  userId       Int?      @unique
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  /// đã ẩn danh hoá PII lúc nào (null = còn dữ liệu thật). Xem customer.anonymize.ts
  anonymizedAt DateTime?

  user         User?             @relation(fields: [userId], references: [id])
  orders       Order[]
  reservations Reservation[]
  /// các lần đổi điểm thành giảm giá (nửa "đã dùng" của số dư điểm)
  redemptions  PointRedemption[]
  /// nhật ký đồng ý xử lý dữ liệu cá nhân (mỗi lần đồng ý/rút là một dòng, không sửa)
  consents     ConsentLog[]

  @@index([deletedAt, createdAt])
}

/// Mục đích xử lý dữ liệu cá nhân — tách theo mục đích vì NĐ 13/2023 buộc đồng ý **theo từng
/// mục đích**: khách cho số để quán liên hệ về đơn KHÔNG có nghĩa là đồng ý nhận quảng cáo.
enum ConsentPurpose {
  /// liên hệ về đơn/đặt bàn — cần để thực hiện việc khách yêu cầu
  SERVICE
  /// gửi ưu đãi, khuyến mại — phải được đồng ý riêng
  MARKETING
}

/// Nhật ký đồng ý xử lý dữ liệu cá nhân (NĐ 13/2023/NĐ-CP, Điều 9).
///
/// APPEND-ONLY: mỗi lần khách đồng ý hoặc rút đồng ý là MỘT DÒNG MỚI; trigger DB chặn UPDATE.
/// "Đang đồng ý" = dòng mới nhất của (customerId, purpose) — muốn biết khách đã đổi ý thì đọc lịch
/// sử, không ghi đè lịch sử. Rút đồng ý KHÔNG xoá dòng cũ, vì chính tờ giấy đồng ý cũ là bằng chứng
/// rằng quán đã có cơ sở xử lý dữ liệu trong khoảng thời gian trước đó.
///
/// `version` = phiên bản chính sách khách đã được đọc; đổi chính sách thì phải hỏi lại (xem
/// `customer.consent-policy.ts`: phiên bản cũ ⇒ coi như chưa đồng ý).
model ConsentLog {
  id          Int            @id @default(autoincrement())
  customerId  Int
  purpose     ConsentPurpose
  /// phiên bản chính sách tại thời điểm ghi nhận
  version     String         @db.VarChar(20)
  /// true = đồng ý, false = rút đồng ý
  granted     Boolean
  /// IP lúc ghi nhận (bằng chứng ai/nơi nào) — null khi ghi qua script nội bộ
  ip          String?        @db.VarChar(45)
  note        String?        @db.VarChar(255)
  createdById Int?
  createdAt   DateTime       @default(now())

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("ConsentLogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customerId, purpose, createdAt])
}

/// Loại chủ thể mà một dòng `AccessLog` nói tới — quyết định `subjectId` là id của bảng nào.
enum AccessSubject {
  /// hồ sơ khách hàng (Customer.id)
  CUSTOMER
  /// tài khoản nhân viên (User.id) — email/SĐT nhân viên cũng là dữ liệu cá nhân
  USER
}

/// Nhật ký TRUY CẬP dữ liệu cá nhân (NĐ 13/2023/NĐ-CP, Điều 26: ghi nhật ký truy cập).
///
/// Khác `AuditLog` ở chỗ đối tượng là NGƯỜI ĐỌC chứ không phải người sửa: đọc 100 lần cũng không
/// đổi dữ liệu, nhưng mỗi lần đọc PII của một khách phải trả lời được "ai đọc, đọc hồ sơ nào, lúc
/// nào". APPEND-ONLY (trigger DB chặn UPDATE) — sửa được nhật ký thì nó không còn là bằng chứng.
model AccessLog {
  id          Int            @id @default(autoincrement())
  /// User.id người đọc (null = hệ thống/script)
  actorId     Int?
  /// tên role tại thời điểm đọc — giữ chuỗi, không FK: role đổi tên vẫn đọc lại được
  actorRole   String?        @db.VarChar(50)
  /// route đã đọc, dạng "GET /customers/:id" — CỐ Ý không lưu query string: query tìm khách
  /// thường chính là SĐT/tên, chép vào nhật ký là nhân bản PII ra thêm một bảng
  route       String         @db.VarChar(120)
  /// loại chủ thể bị đọc; NULL với route dạng danh sách (khi đó `resultCount` cho biết đọc bao nhiêu)
  ///
  /// Dùng cặp (type, id) thay vì một cột cho mỗi module: bảng này cố ý không có khoá ngoại nào (xem
  /// ghi chú ở các `@@index`), nên thêm một module mới chỉ là thêm một giá trị enum, không phải
  /// thêm cột + migration + sửa mọi câu truy vấn.
  subjectType AccessSubject?
  /// id chủ thể trong bảng của `subjectType` (Customer.id / User.id) — chỉ là một con số
  subjectId   Int?
  /// số bản ghi trả về (route danh sách) / 1 (route một hồ sơ)
  resultCount Int?
  /// IP người đọc
  ip          String?        @db.VarChar(45)
  createdAt   DateTime       @default(now())

  /// KHÔNG đặt khoá ngoại tới Customer/User: xoá hồ sơ không được làm biến mất bằng chứng
  /// "đã có người đọc hồ sơ này". Số `subjectId` còn lại chỉ là một con số, không phải PII.
  @@index([subjectType, subjectId, createdAt])
  @@index([actorId, createdAt])
  @@index([route, createdAt])
}

model Category {
  id                   Int                   @id @default(autoincrement())
  logo                 String                @db.VarChar(1000)
  name                 String                @db.VarChar(500)
  parentCategoryId     Int?
  createdById          Int?
  updatedById          Int?
  deletedById          Int?
  deletedAt            DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  createdBy            User?                 @relation("CategoryCreateBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deletedBy            User?                 @relation("CategoryDeleteBy", fields: [deletedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentCategory       Category?             @relation("ParentCategoryCategoies", fields: [parentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childrenCategories   Category[]            @relation("ParentCategoryCategoies")
  updatedBy            User?                 @relation("CategoryUpdateBy", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categoryTranslations CategoryTranslation[]
  products             Product[]             @relation("CategoryToProduct")

  @@index([deletedAt])
}

model CategoryTranslation {
  id          Int       @id @default(autoincrement())
  categoryId  Int
  languageId  String
  name        String    @db.VarChar(500)
  description String
  createdById Int?
  updatedById Int?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedById Int?
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdBy   User?     @relation("CategoryTranslationCreateBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deletedBy   User?     @relation("CategoryTranslationDeleteBy", fields: [deletedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  language    Language  @relation(fields: [languageId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  updatedBy   User?     @relation("CategoryTranslationUpdateBy", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([deletedAt])
}

model VerificationCode {
  id         Int                  @id @default(autoincrement())
  email      String               @db.VarChar(500)
  /// sha256 hex của mã OTP — DB không giữ plaintext (prod-readiness M1)
  codeHash   String               @db.VarChar(64)
  type       VerificationCodeType
  /// Số lượt nhập sai của chính mã này; chạm ngưỡng thì mã bị vô hiệu, phải xin mã mới
  attempts   Int                  @default(0)
  /// Mã đã dùng, hoặc đã bị mã mới thay thế. Giữ dòng để đếm lượt gửi trong cửa sổ 15 phút
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime             @default(now())

  @@index([email, type, createdAt])
  @@index([expiresAt])
}

enum PaymentMethod {
  CASH
  VNPAY
  CARD
  TRANSFER
}

/// Chot lai "lan thu tien nay se thu bao nhieu, cho nhung don nao" ngay luc tao URL thanh toan.
/// Webhook chi doi chieu voi ban ghi nay, khong tinh lai tu gio hang dang thay doi.
model PaymentIntent {
  id         Int       @id @default(autoincrement())
  provider   String    @db.VarChar(32)
  reference  String    @unique @db.VarChar(128)
  amount     Decimal   @db.Decimal(14, 2)
  currency   String    @default("VND") @db.VarChar(3)
  orderIds   Int[]
  status     String    @default("PENDING") @db.VarChar(20)
  payload    Json?
  createdAt  DateTime  @default(now())
  consumedAt DateTime?

  @@index([status, createdAt])
}

model WebhookEvent {
  id         Int      @id @default(autoincrement())
  provider   String   @db.VarChar(32)
  externalId String   @db.VarChar(128)
  payload    Json?
  receivedAt DateTime @default(now())

  @@unique([provider, externalId])
  @@index([receivedAt])
}

model Payment {
  id             Int            @id @default(autoincrement())
  amount         Decimal        @db.Decimal(14, 2)
  method         PaymentMethod?
  gatewayCode    String?        @db.VarChar(32)
  status         PaymentStatus  @default(PENDING)
  transactionId  String?
  currency       String         @default("VND") @db.VarChar(3)
  paidAt         DateTime?
  refundedAmount Decimal        @default(0) @db.Decimal(14, 2)
  gatewayPayload Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  order          Order[]
  branchId       Int
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orderId        Int?
  settlingOrder  Order?         @relation("OrderSettlingPayments", fields: [orderId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([transactionId])
  /// đối soát / báo cáo theo kỳ: lọc Payment SUCCESS trong khoảng paidAt
  @@index([status, paidAt])
  @@index([branchId, paidAt])
  /// lần thu tiền thứ hai (phần còn lại sau cọc) trỏ về đơn của nó.
  @@index([orderId])
}

model Message {
  id          Int       @id @default(autoincrement())
  fromUserId  Int?
  toUserId    Int?
  content     String
  readAt      DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())
  fromGuestId Int?
  toGuestId   Int?
  fromGuest   Guest?    @relation("FromGuest", fields: [fromGuestId], references: [id])
  fromUser    User?     @relation("FromUser", fields: [fromUserId], references: [id])
  toGuest     Guest?    @relation("ToGuest", fields: [toGuestId], references: [id])
  toUser      User?     @relation("ToUser", fields: [toUserId], references: [id])

  @@index([fromUserId, toUserId])
  @@index([fromGuestId])
  @@index([toGuestId])
}

model Unit {
  name                 String                @id @db.VarChar(100)
  createdAt            DateTime              @default(now())
  description          String                @default("")
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  createdById          Int?
  deletedById          Int?
  updatedById          Int?
  ingredients          Ingredient[]
  skuRecipeIngredients SKURecipeIngredient[]
  createdBy            User?                 @relation("UnitCreateBy", fields: [createdById], references: [id])
  deletedBy            User?                 @relation("UnitDeleteBy", fields: [deletedById], references: [id])
  updatedBy            User?                 @relation("UnitUpdateBy", fields: [updatedById], references: [id])
  fromUnitConversion   UnitConversion[]      @relation("fromUnit")
  toUnitConversion     UnitConversion[]      @relation("toUnit")

  @@index([deletedAt])
}

model UnitConversion {
  id          Int       @id @default(autoincrement())
  fromUnitId  String
  toUnitId    String
  factor      Float
  createdById Int?
  deletedById Int?
  updatedById Int?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  updatedAt   DateTime  @updatedAt
  createdBy   User?     @relation("UnitConversionCreateBy", fields: [createdById], references: [id])
  deletedBy   User?     @relation("UnitConversionDeleteBy", fields: [deletedById], references: [id])
  fromUnit    Unit      @relation("fromUnit", fields: [fromUnitId], references: [name])
  toUnit      Unit      @relation("toUnit", fields: [toUnitId], references: [name])
  updatedBy   User?     @relation("UnitConversionUpdateBy", fields: [updatedById], references: [id])

  @@unique([fromUnitId, toUnitId])
}

model Ingredient {
  id                  Int                   @id @default(autoincrement())
  name                String
  stock               Float                 @default(0)
  unitId              String
  /// Giá nhập bình quân cho 1 đơn vị `unitId` (ticket #11). 0 = chưa khai giá -> COGS = 0, không đoán.
  unitCost            Decimal               @default(0) @db.Decimal(14, 2)
  minStock            Float?                @default(0)
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  createdById         Int?
  deletedAt           DateTime?
  deletedById         Int?
  updatedById         Int?
  image               String?
  stockReceipts       StockReceipt[]
  createdBy           User?                 @relation("ingredientCreateBy", fields: [createdById], references: [id])
  deletedBy           User?                 @relation("ingredientDeleteBy", fields: [deletedById], references: [id])
  unit                Unit                  @relation(fields: [unitId], references: [name], onDelete: NoAction, onUpdate: NoAction)
  updatedBy           User?                 @relation("ingredientUpdateBy", fields: [updatedById], references: [id])
  skuRecipeIngredient SKURecipeIngredient[]
}

model Voucher {
  id               Int               @id @default(autoincrement())
  code             String            @unique @db.VarChar(100)
  discountType     VoucherType
  discountValue    Decimal           @db.Decimal(14, 2)
  startAt          DateTime
  endAt            DateTime
  usageLimit       Int?
  /// Số lượt đã dùng — counter để CLAIM NGUYÊN TỬ. Trước đây chỉ đếm `VoucherSnapshot` rồi mới
  /// tạo, nên 2 request đồng thời cùng đọc `usedCount = limit - 1` và cùng vượt hạn mức.
  usedCount        Int               @default(0)
  status           VoucherStatus     @default(ACTIVE)
  createdById      Int?
  updatedById      Int?
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdBy        User?             @relation("VoucherCreateBy", fields: [createdById], references: [id])
  updatedBy        User?             @relation("VoucherUpdateBy", fields: [updatedById], references: [id])
  voucherSnapshots VoucherSnapshot[]

  @@index([deletedAt])
}

model VoucherSnapshot {
  id              Int         @id @default(autoincrement())
  voucherId       Int
  code            String
  discountType    VoucherType
  discountValue   Decimal     @db.Decimal(14, 2)
  /// Số tiền THỰC SỰ đã giảm cho đơn này (khác `discountValue`: PERCENT 10% của 100k = 10k).
  /// Không có cột này thì đối soát/audit chỉ biết "voucher 10%" mà không biết đã trừ bao nhiêu tiền.
  appliedDiscount Decimal     @default(0) @db.Decimal(14, 2)
  startAt         DateTime
  endAt           DateTime
  createdAt       DateTime    @default(now())
  orders          Order[]
  voucher         Voucher     @relation(fields: [voucherId], references: [id])
}

/// *
/// * RecipeIngredient: là bảng trung gian (junction table) để nối:
/// * - 1 công thức (recipeId)
/// * - 1 nguyên liệu (ingredientId)
/// * - kèm thêm thông tin bổ sung: quantity, unitId
/// Một lần NHẬP HÀNG: hàng về bao nhiêu, giá bao nhiêu, ai nhận, ảnh bằng chứng.
/// Tồn kho KHÔNG ghi đè mà CỘNG dồn (`stock = stock + quantity`), nên không thể "nhập 5 mà mất 10".
/// `unitCost` của nguyên liệu được tính lại theo bình quân gia quyền để COGS sát thực tế.
model StockReceipt {
  id           Int        @id @default(autoincrement())
  ingredientId Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  /// số lượng nhập, theo đơn vị của nguyên liệu (Ingredient.unitId)
  quantity     Float
  /// giá nhập cho 1 đơn vị trong lần này
  unitCost     Decimal    @default(0) @db.Decimal(14, 2)
  /// nhà cung cấp (chuỗi tự do — chưa có danh mục NCC)
  supplier     String?    @db.VarChar(255)
  note         String?    @db.VarChar(500)
  /// ảnh bằng chứng (phiếu giao hàng, hàng thực tế) — URL từ /media
  images       String[]
  /// giá trị tồn SAU khi nhập, để đọc lại biết ngay đã cộng đúng
  stockAfter   Float
  receivedAt   DateTime   @default(now())
  createdById  Int?
  createdBy    User?      @relation("StockReceiptCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt    DateTime   @default(now())

  @@index([ingredientId, receivedAt])
}

model SKURecipeIngredient {
  id           Int        @id @default(autoincrement())
  skuId        Int
  ingredientId Int
  quantity     Float
  unitId       String
  createdAt    DateTime   @default(now())
