# Copy file nay thanh .env roi dien gia tri that.  KHONG commit file .env
# Du lieu local (docker compose o thu muc cha):
#   Postgres :127.0.0.1:5433  user=postgres  db=ecommerce  (container res-mana-postgres)
#   Redis    :redis://localhost:6379                       (container res-mana-redis)

PORT=4000

# --- Database (phai co ca 2: prisma migrate dev can shadow DB) ---
DATABASE_URL="postgresql://postgres:MAT_KHAU@127.0.0.1:5433/ecommerce?schema=public"
SHADOW_DATABASE_URL="postgresql://postgres:MAT_KHAU@127.0.0.1:5433/ecommerce_shadow?schema=public"

# --- Cache / queue ---
REDIS_URL=redis://localhost:6379

# --- Tai khoan admin duoc seed ---
Admin_name=admin
Admin_password=doi_mat_khau_nay
Admin_email=admin@example.com
# Múi giờ: Node đọc lúc khởi động -> phải có biến này trong container/host,
# không chỉ dựa vào src/shared/config/timezone.ts
TZ=Asia/Ho_Chi_Minh
ADMIN_ID=1
# Dùng cho `npm run init-seed-data` (tạo role + tài khoản admin đầu tiên)
ADMIN_EMAIL=admin@order.com
ADMIN_NAME=admin
ADMIN_PASSWORD=123456

# --- JWT ---
ACCESS_TOKEN_SECRET=doi_thanh_chuoi_ngau_nhien_1
REFRESH_TOKEN_SECRET=doi_thanh_chuoi_ngau_nhien_2
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=1d

# --- OTP / email ---
OTP_EXPIRES_IN=5m
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# --- Cloudinary (upload anh) ---
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# --- VNPay ---
PAYMENT_API_KEY=
VNPAY_TMN_CODE=
VNPAY_SECRET_KEY=
VNPAY_URL=
VNPAY_API_URL=
VNPAY_RETURN_URL=

# --- URL frontend (dung cho redirect sau thanh toan / CORS neu bat) ---
FRONTEND_URL=http://localhost:3000
